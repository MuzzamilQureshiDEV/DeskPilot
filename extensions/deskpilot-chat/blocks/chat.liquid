{%- comment -%}
  AstaDesk storefront chat (app embed). Talks to AstaDesk only through the
  store's own app proxy (/apps/deskpilot), which Shopify signs.
{%- endcomment -%}
<div
  id="deskpilot-chat"
  class="dpc-root dpc-{% if block.settings.position == 'left' %}left{% else %}right{% endif %}"
  data-endpoint="/apps/deskpilot/messages"
  data-config="/apps/deskpilot/config"
  data-accent="{{ block.settings.accent | escape }}"
  data-title="{{ block.settings.title | escape }}"
  data-subtitle="{{ block.settings.subtitle | escape }}"
  data-greeting="{{ block.settings.greeting | escape }}"
  data-position="{{ block.settings.position | escape }}"
  data-open-label="{{ 'chat.open' | t | escape }}"
  data-close-label="{{ 'chat.close' | t | escape }}"
  hidden
></div>

{% schema %}
{
  "name": "AstaDesk chat",
  "target": "body",
  "javascript": "deskpilot-chat.js",
  "stylesheet": "deskpilot-chat.css",
  "settings": [
    { "type": "paragraph", "content": "Set the colour, texts and quick questions in AstaDesk → Settings → Chat widget. Fill a field here only to override it for this theme." },
    { "type": "color", "id": "accent", "label": "Accent colour (optional override)" },
    { "type": "text", "id": "title", "label": "Chat title (optional override)" },
    { "type": "text", "id": "subtitle", "label": "Subtitle (optional override)" },
    { "type": "text", "id": "greeting", "label": "Greeting (optional override)" },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        { "value": "", "label": "Use AstaDesk setting" },
        { "value": "right", "label": "Bottom right" },
        { "value": "left", "label": "Bottom left" }
      ],
      "default": ""
    }
  ]
}
{% endschema %}
